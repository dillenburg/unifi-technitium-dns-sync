# Copy to .env. Replace all example hosts and credentials locally.
UNIFI_NETWORK_HOST=unifi.example.com
UNIFI_API_KEY=replace-locally
UNIFI_NETWORK_VERIFY_SSL=true
TECHNITIUM_DNS01_HOST=dns01.example.com
TECHNITIUM_DNS02_HOST=dns02.example.com
DNS01_TOKEN=replace-locally
DNS02_TOKEN=replace-locally
TECHNITIUM_SCHEME=https
# Set the actual HTTPS API port configured on your server.
TECHNITIUM_PORT=5380
TECHNITIUM_VERIFY_SSL=true
ALLOW_INSECURE_TECHNITIUM_HTTP=false
SYNC_SUBNET=192.0.2.0/24
SYNC_NETWORK_NAME=example-network
DNS_SUFFIX=clients.example.com
# Optional alternative to SYNC_SUBNET. Non-overlapping IPv4 scopes only.
# SYNC_SCOPES_JSON=[{"name":"lab","subnet":"192.0.2.0/24","dns_suffix":"clients.example.com"},{"name":"iot","subnet":"198.51.100.0/24","dns_suffix":"clients.example.com"}]
DRY_RUN=true
POLL_INTERVAL=300
STALE_AFTER_DAYS=30
DB_PATH=/data/state.db
INFISICAL_ENABLED=false
# Infisical mode replaces the three runtime credentials above.
# INFISICAL_URL=https://secrets.example.com
# INFISICAL_CLIENT_ID=replace-locally
# INFISICAL_CLIENT_SECRET=replace-locally
# INFISICAL_PROJECT_ID=replace-locally
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_SECRET_PATH=/
# Only for the optional external Macvlan Compose example:
# DOCKER_NETWORK_NAME=your-existing-network
# CONTAINER_IPV4=192.0.2.20
